{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeHarness",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:InvokeHarness",
        "bedrock-agentcore:InvokeAgentRuntime"
      ],
      "Resource": [
        "arn:aws:bedrock-agentcore:ap-northeast-2:180294183052:harness/AgenticBookBuilderDemo-6R0pXEwrY1",
        "arn:aws:bedrock-agentcore:ap-northeast-2:180294183052:runtime/harness_AgenticBookBuilderDemo*"
      ]
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-northeast-2:180294183052:log-group:/aws/lambda/agentic-book-demo-site*"
    },
    {
      "Sid": "Registry",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query"
      ],
      "Resource": "arn:aws:dynamodb:ap-northeast-2:180294183052:table/agentic-book-demo-registry"
    },
    {
      "Sid": "AgentRegistry",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:CreateRegistryRecord",
        "bedrock-agentcore:GetRegistryRecord",
        "bedrock-agentcore:SubmitRegistryRecordForApproval",
        "bedrock-agentcore:UpdateRegistryRecordStatus",
        "bedrock-agentcore:DeleteRegistryRecord"
      ],
      "Resource": [
        "arn:aws:bedrock-agentcore:us-east-1:180294183052:registry/b2hOSZL4eOhDXAyk",
        "arn:aws:bedrock-agentcore:us-east-1:180294183052:registry/b2hOSZL4eOhDXAyk/record/*"
      ]
    },
    {
      "Sid": "SkillsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::agentic-nexus-skills-180294183052/skills/*"
    },
    {
      "Sid": "SelfInvokeAsync",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:ap-northeast-2:180294183052:function:agentic-book-demo-site"
    }
  ]
}