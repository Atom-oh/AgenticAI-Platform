{
  "id": "sm-deposit-signup-v1",
  "title": "수신 가입 프로세스 UX SM 모델 (합성)",
  "note": "미팅(2026-09-03)에서 UX팀이 정의한 3계층 — 몰큘=인텐트, 오가니즘=구성·룰·관계, 템플릿=구조·위치 — 를 합성 샘플로 만든 것. 실제 하나은행 SM 모델이 아니다.",
  "molecules": [
    {"id": "btn-primary", "intent": "다음 단계로 진행하는 주 행동"},
    {"id": "btn-secondary", "intent": "이전/취소 등 보조 행동"},
    {"id": "product-title", "intent": "상품명과 한 줄 소개"},
    {"id": "rate-badge", "intent": "기본금리·최고금리를 눈에 띄게 표기"},
    {"id": "info-row", "intent": "라벨-값 한 줄 (기간·금액·대상)"},
    {"id": "checkbox-consent", "intent": "약관·설명서 동의 체크"},
    {"id": "notice-text", "intent": "법정 필수 고지 문구"},
    {"id": "amount-field", "intent": "금액 입력 + 단위·범위 안내"},
    {"id": "term-select", "intent": "가입 기간 선택"},
    {"id": "condition-card", "intent": "우대조건 1건 (조건·우대금리·충족 방식)"},
    {"id": "text-field", "intent": "문자 입력 + 형식 안내 + 오류 문구"},
    {"id": "help-text", "intent": "입력 도움말"},
    {"id": "summary-row", "intent": "확인 화면의 항목-값 요약"},
    {"id": "progress-bar", "intent": "현재 스텝 위치 표시"},
    {"id": "status-icon", "intent": "완료/실패 상태 아이콘"}
  ],
  "organisms": [
    {"id": "product-summary", "title": "상품 요약 헤더",
     "composition": ["product-title", "rate-badge", "info-row"],
     "rules": ["기본금리와 최고 우대금리를 함께 표기", "가입 대상·기간·금액 한도를 한 줄씩"],
     "required": ["기본금리", "가입 대상"], "relations": []},
    {"id": "cta-start", "title": "가입 시작 CTA", "composition": ["btn-primary"],
     "rules": ["버튼 문구는 전이 트리거와 동일"], "required": [], "relations": []},
    {"id": "eligibility-check", "title": "가입 자격 확인", "composition": ["info-row", "checkbox-consent", "btn-primary"],
     "rules": ["자격 요건을 열거하고 본인 확인 체크"], "required": ["가입 자격"], "relations": []},
    {"id": "terms-consent", "title": "약관·상품설명서 동의", "composition": ["checkbox-consent", "btn-primary"],
     "rules": ["전체 동의 + 개별 동의", "필수 항목 미동의 시 진행 불가"], "required": ["상품설명서", "약관"], "relations": []},
    {"id": "notice-list", "title": "필수 고지 목록", "composition": ["notice-text"],
     "rules": ["명세서의 필수 고지를 글자 그대로"], "required": [], "relations": []},
    {"id": "amount-input", "title": "가입 금액 입력", "composition": ["amount-field", "help-text"],
     "rules": ["범위 밖 입력 시 오류 문구"], "required": ["월 납입액"], "relations": []},
    {"id": "term-select", "title": "가입 기간 선택", "composition": ["term-select"],
     "rules": ["명세서 기간 옵션만"], "required": ["가입 기간"], "relations": []},
    {"id": "preferential-list", "title": "우대조건 목록", "composition": ["condition-card", "btn-primary"],
     "rules": ["조건별 우대금리 표기", "증빙이 필요한 조건은 선택 시 증빙 입력 스텝으로 분기"],
     "required": ["우대금리"],
     "relations": [{"when": "증빙 입력형 우대조건 선택", "enable": "evidence-input"}]},
    {"id": "evidence-input", "title": "우대조건 증빙 입력", "composition": ["text-field", "help-text", "btn-primary", "btn-secondary"],
     "rules": ["입력 형식 안내 문구 존재", "형식 오류 시 오류 문구", "건너뛰기 시 해당 우대 미적용 안내"],
     "required": ["형식", "우대 미적용"], "relations": []},
    {"id": "summary-table", "title": "가입 내용 요약", "composition": ["summary-row"],
     "rules": ["상품명·금액·기간·적용 우대·예상 금리"], "required": ["적용 우대", "예상"], "relations": []},
    {"id": "final-consent", "title": "최종 확인 동의", "composition": ["checkbox-consent", "btn-primary"],
     "rules": ["가입 신청 버튼은 동의 후 활성화"], "required": [], "relations": []},
    {"id": "complete-message", "title": "가입 완료 메시지", "composition": ["status-icon", "summary-row"],
     "rules": ["계좌번호·첫 납입일 표기"], "required": ["계좌번호"], "relations": []},
    {"id": "next-actions", "title": "다음 행동", "composition": ["btn-primary", "btn-secondary"],
     "rules": ["계좌 조회·상담 연결"], "required": ["조회"], "relations": []}
  ],
  "templates": [
    {"id": "deposit-signup", "title": "수신 상품 가입 프로세스", "appliesTo": {"productType": "수신"},
     "steps": [
       {"id": "intro", "title": "상품 안내", "organisms": ["product-summary", "cta-start"]},
       {"id": "eligibility", "title": "가입 자격 확인", "organisms": ["eligibility-check"]},
       {"id": "terms", "title": "약관·상품설명서 동의", "organisms": ["terms-consent", "notice-list"]},
       {"id": "amount", "title": "가입 금액·기간", "organisms": ["amount-input", "term-select"]},
       {"id": "preferential", "title": "우대조건 선택", "organisms": ["preferential-list"]},
       {"id": "confirm", "title": "가입 내용 확인", "organisms": ["summary-table", "final-consent"]},
       {"id": "complete", "title": "가입 완료", "organisms": ["complete-message", "next-actions"]}
     ]}
  ]
}
