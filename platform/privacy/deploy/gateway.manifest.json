{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "bank-platform-mydata",
        "labels": {
          "pod-security.kubernetes.io/enforce": "restricted",
          "pod-security.kubernetes.io/enforce-version": "v1.31"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {"name": "mydata-privacy-gateway", "namespace": "bank-platform-mydata"},
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {"name": "mydata-privacy-gateway", "namespace": "bank-platform-mydata"},
      "spec": {
        "replicas": 1,
        "revisionHistoryLimit": 2,
        "selector": {"matchLabels": {"app": "mydata-privacy-gateway"}},
        "strategy": {"type": "RollingUpdate", "rollingUpdate": {"maxUnavailable": 0, "maxSurge": 1}},
        "template": {
          "metadata": {"labels": {"app": "mydata-privacy-gateway"}},
          "spec": {
            "serviceAccountName": "mydata-privacy-gateway",
            "automountServiceAccountToken": false,
            "nodeSelector": {"node-type": "graviton", "kubernetes.io/arch": "arm64"},
            "terminationGracePeriodSeconds": 150,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "seccompProfile": {"type": "RuntimeDefault"}
            },
            "containers": [{
              "name": "gateway",
              "image": "${IMAGE}",
              "imagePullPolicy": "IfNotPresent",
              "ports": [{"name": "http", "containerPort": 8080}],
              "env": [
                {"name": "QWEN_MODEL_REVISION", "value": "${MODEL_REVISION}"},
                {"name": "PORT", "value": "8080"},
                {"name": "PYTHONDONTWRITEBYTECODE", "value": "1"},
                {"name": "PYTHONUNBUFFERED", "value": "1"}
              ],
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "readOnlyRootFilesystem": true,
                "capabilities": {"drop": ["ALL"]}
              },
              "resources": {
                "requests": {"cpu": "100m", "memory": "128Mi"},
                "limits": {"cpu": "1", "memory": "512Mi"}
              },
              "startupProbe": {"httpGet": {"path": "/health", "port": "http"}, "periodSeconds": 5, "failureThreshold": 12},
              "readinessProbe": {"httpGet": {"path": "/health", "port": "http"}, "periodSeconds": 10, "timeoutSeconds": 3},
              "livenessProbe": {"httpGet": {"path": "/health", "port": "http"}, "periodSeconds": 30, "timeoutSeconds": 3},
              "volumeMounts": [{"name": "tmp", "mountPath": "/tmp"}]
            }],
            "volumes": [{"name": "tmp", "emptyDir": {"medium": "Memory", "sizeLimit": "32Mi"}}]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {"name": "mydata-privacy-gateway", "namespace": "bank-platform-mydata"},
      "spec": {
        "type": "ClusterIP",
        "selector": {"app": "mydata-privacy-gateway"},
        "ports": [{"name": "http", "port": 8080, "targetPort": "http", "protocol": "TCP"}]
      }
    },
    {
      "apiVersion": "elbv2.k8s.aws/v1beta1",
      "kind": "TargetGroupBinding",
      "metadata": {"name": "mydata-privacy-gateway", "namespace": "bank-platform-mydata"},
      "spec": {
        "serviceRef": {"name": "mydata-privacy-gateway", "port": 8080},
        "targetGroupARN": "${TARGET_GROUP_ARN}",
        "targetType": "ip",
        "vpcID": "${VPC_ID}"
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {"name": "mydata-privacy-gateway", "namespace": "bank-platform-mydata"},
      "spec": {
        "podSelector": {"matchLabels": {"app": "mydata-privacy-gateway"}},
        "policyTypes": ["Ingress", "Egress"],
        "ingress": [{
          "from": [{"ipBlock": {"cidr": "${NLB_ADDRESS}/32"}}],
          "ports": [{"port": 8080, "protocol": "TCP"}]
        }],
        "egress": [
          {
            "to": [{
              "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "sllm"}},
              "podSelector": {"matchLabels": {"app": "qwen-sllm"}}
            }],
            "ports": [{"port": 8080, "protocol": "TCP"}]
          },
          {
            "to": [{
              "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "kube-system"}},
              "podSelector": {"matchLabels": {"k8s-app": "kube-dns"}}
            }],
            "ports": [{"port": 53, "protocol": "UDP"}, {"port": 53, "protocol": "TCP"}]
          }
        ]
      }
    }
  ]
}
