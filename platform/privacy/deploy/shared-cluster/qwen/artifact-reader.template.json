{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Qwen artifact prefetch worker for fsi-demo-cluster; exact S3 objects via existing private endpoint",
  "Resources": {
    "QwenArtifactReader": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "fsi-demo-qwen-artifacts",
        "Description": "CPU-only Qwen artifact prefetch worker; no serving-pod credentials",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": "arn:aws:iam::180294183052:oidc-provider/oidc.eks.ap-northeast-2.amazonaws.com/id/269C604E98E9CB47E169C868AC3A1587"
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "oidc.eks.ap-northeast-2.amazonaws.com/id/269C604E98E9CB47E169C868AC3A1587:aud": "sts.amazonaws.com",
                  "oidc.eks.ap-northeast-2.amazonaws.com/id/269C604E98E9CB47E169C868AC3A1587:sub": "system:serviceaccount:sllm:qwen-artifacts"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ReadExactPinnedArtifacts",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ReadPinnedQwenArtifactsThroughGateway",
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": [
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-8B/b968826d9c46dd6066d109eabc6255188de91218/LICENSE",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-8B/b968826d9c46dd6066d109eabc6255188de91218/config.json",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-8B/b968826d9c46dd6066d109eabc6255188de91218/generation_config.json",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-8B/b968826d9c46dd6066d109eabc6255188de91218/merges.txt",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-8B/b968826d9c46dd6066d109eabc6255188de91218/model-00001-of-00005.safetensors",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-8B/b968826d9c46dd6066d109eabc6255188de91218/model-00002-of-00005.safetensors",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-8B/b968826d9c46dd6066d109eabc6255188de91218/model-00003-of-00005.safetensors",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-8B/b968826d9c46dd6066d109eabc6255188de91218/model-00004-of-00005.safetensors",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-8B/b968826d9c46dd6066d109eabc6255188de91218/model-00005-of-00005.safetensors",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-8B/b968826d9c46dd6066d109eabc6255188de91218/model.safetensors.index.json",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-8B/b968826d9c46dd6066d109eabc6255188de91218/tokenizer.json",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-8B/b968826d9c46dd6066d109eabc6255188de91218/tokenizer_config.json",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-8B/b968826d9c46dd6066d109eabc6255188de91218/vocab.json",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-0.6B/c1899de289a04d12100db370d81485cdf75e47ca/LICENSE",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-0.6B/c1899de289a04d12100db370d81485cdf75e47ca/config.json",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-0.6B/c1899de289a04d12100db370d81485cdf75e47ca/generation_config.json",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-0.6B/c1899de289a04d12100db370d81485cdf75e47ca/merges.txt",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-0.6B/c1899de289a04d12100db370d81485cdf75e47ca/model.safetensors",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-0.6B/c1899de289a04d12100db370d81485cdf75e47ca/tokenizer.json",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-0.6B/c1899de289a04d12100db370d81485cdf75e47ca/tokenizer_config.json",
                    "arn:aws:s3:::fsi-demo-models-180294183052/qwen-offline/Qwen3-0.6B/c1899de289a04d12100db370d81485cdf75e47ca/vocab.json"
                  ],
                  "Condition": {
                    "StringEquals": {
                      "aws:SourceVpce": "vpce-04a82e15d312f39b8"
                    },
                    "Bool": {
                      "aws:SecureTransport": "true"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "QwenArtifactReaderArn": {
      "Value": {
        "Fn::GetAtt": [
          "QwenArtifactReader",
          "Arn"
        ]
      }
    }
  }
}
